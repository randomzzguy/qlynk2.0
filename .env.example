# Copy to .env.local. Use your own development providers, never Qlynk production credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Auth, Postgres and Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# AI inference; provider usage may be billed separately
GROQ_API_KEY=your-groq-key
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# Set to 0 to disable optional sentiment analysis completely.
# GROQ_SENTIMENT_ENABLED=1
# Shared budget scope identifies one Groq organization, NOT an API key.
# Keep it identical across deployments sharing that organization and database.
# GROQ_QUOTA_SCOPE=qlynk-groq
# Set a distinct demo scope ONLY for a genuinely separate Groq organization.
# GROQ_DEMO_QUOTA_SCOPE=
# Defaults for each GPT-OSS model: 24 RPM, 800/day, 6400 tokens/min,
# 160000 tokens/day, 3 simultaneous calls. Confirm against your account limits.
# A model override requires all five fields. Unknown models require an entry.
# GROQ_QUOTA_LIMITS_JSON={"openai/gpt-oss-120b":{"rpm":24,"rpd":800,"tpm":6400,"tpd":160000,"concurrency":3},"openai/gpt-oss-20b":{"rpm":24,"rpd":800,"tpm":6400,"tpd":160000,"concurrency":3}}

# Leave hosted billing disabled for a free-only self-hosted deployment.
# Set to 1 and configure Stripe to offer paid Agency subscriptions.
NEXT_PUBLIC_BILLING_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICE_AGENCY_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_AGENCY_ANNUAL=
STRIPE_PORTAL_CONFIGURATION_ID=
# Historical Creator prices are only needed to reconcile old paid subscriptions.
# NEXT_PUBLIC_STRIPE_PRICE_CREATOR_MONTHLY=
# NEXT_PUBLIC_STRIPE_PRICE_CREATOR_ANNUAL=

# Bot protection. Local development uses the existing localhost bypass only.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Optional welcome/conversation/billing email delivery (Supabase sends Auth email).
RESEND_API_KEY=
EMAIL_FROM=
# Example when enabling Resend: EMAIL_FROM=Qlynk <your-verified-sender@example.com>

# Set a long random value in deployments that use protected cron routes.
CRON_SECRET=

# Read-only capacity checks: adjust these application thresholds to your plan.
# MONITOR_DATABASE_LIMIT_BYTES=500000000
# MONITOR_STORAGE_LIMIT_BYTES=1000000000
# Operator-only backup checks; never expose this access token publicly.
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# BACKUP_MAX_AGE_HOURS=48

# Advanced knowledge features require their documented migrations/worker setup.
KNOWLEDGE_EMBEDDINGS_ENABLED=0
KNOWLEDGE_GRAPH_ENABLED=0
KNOWLEDGE_MEMORY_ENABLED=0
KNOWLEDGE_EMBEDDINGS_SECRET=
